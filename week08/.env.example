# Copy this file to .env and fill in the values.
# Then `source .env` or use your shell's env-loader of choice.

# ─── Required: OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...

# ─── Qdrant — pick ONE of the two modes below ────────────────────────

# Mode 1: Qdrant Cloud (free tier, 1 GB cluster).
# QDRANT_URL=https://YOUR-CLUSTER-ID.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# Mode 2: Local Docker (no API key needed).
#   docker run -p 6333:6333 qdrant/qdrant
# QDRANT_URL=http://localhost:6333

# Default: http://localhost:6333 (assumes local Docker).
